{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["run_id", "loop_id", "event_type", "start_state", "end_state", "input_commit", "output_commit", "task_hash", "command_summary", "changed_files", "test_results", "verification_result", "state_transition", "failure_reason", "human_approval_id", "network_calls", "model_fits", "evaluations", "timestamp"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1}, "loop_id": {"type": "string", "minLength": 1}, "event_type": {"type": "string", "minLength": 1}, "start_state": {"$ref": "#/$defs/state"}, "end_state": {"$ref": "#/$defs/state"}, "input_commit": {"$ref": "#/$defs/commit"}, "output_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}, "task_hash": {"$ref": "#/$defs/sha256"}, "command_summary": {"type": "string"}, "changed_files": {"type": "array", "items": {"type": "string"}}, "test_results": {"type": "object", "additionalProperties": true}, "verification_result": {"type": "string"}, "state_transition": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["from", "to"], "properties": {"from": {"$ref": "#/$defs/state"}, "to": {"$ref": "#/$defs/state"}}, "additionalProperties": false}]}, "failure_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "human_approval_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "network_calls": {"type": "integer", "minimum": 0}, "model_fits": {"type": "integer", "minimum": 0}, "evaluations": {"type": "integer", "minimum": 0}, "timestamp": {"type": "string", "format": "date-time"}
  },
  "$defs": {"state": {"type": "string", "enum": ["NEW", "PLANNED", "READY", "IMPLEMENTING", "VERIFYING", "RETRY_ALLOWED", "HUMAN_GATE", "ACCEPTED", "REJECTED", "BLOCKED", "CANCELLED", "DONE"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "additionalProperties": false
}
